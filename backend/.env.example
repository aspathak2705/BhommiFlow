# ==============================================================================
# BhoomiFlow App Configuration Settings
# ==============================================================================

# Application Environment Mode
# Set to 'production' to enforce strict connectivity validation checks.
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Phase A: Database Persistence Configuration
# ------------------------------------------------------------------------------
# Precedence: SUPABASE_DATABASE_URL is used first if set.
# Otherwise, fall back to the standard local DATABASE_URL value.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bhoomiflow
SUPABASE_DATABASE_URL=

# ------------------------------------------------------------------------------
# Phase B: RAG Grounding & RAG NIM Inference API
# ------------------------------------------------------------------------------
# NVIDIA NIM API Credentials
NVIDIA_API_KEY=
# Custom model endpoint base URL for completion calls
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Grounding model tag reference
NVIDIA_MODEL=meta/llama-3.1-405b-instruct

# ------------------------------------------------------------------------------
# Phase B: SMS Notification Delivery Client Parameters
# ------------------------------------------------------------------------------
# Select provider integration ('twilio' supported by default)
SMS_PROVIDER=twilio
# Twilio Account SID
SMS_API_KEY=
# Twilio Auth Token
SMS_API_SECRET=
# Twilio phone number or alphanumeric Sender ID
SMS_SENDER_ID=

# ------------------------------------------------------------------------------
# Phase C: Sarvam AI Speech-to-Text & Text-to-Speech Parameters
# ------------------------------------------------------------------------------
# Speech Provider Integration ('sarvam' or 'offline')
SPEECH_PROVIDER=offline
# Sarvam subscription key
SARVAM_API_KEY=
# Sarvam API Base URL
SARVAM_BASE_URL=https://api.sarvam.ai
# Bulbul TTS voice model selector
SARVAM_TTS_MODEL=bulbul:v1
# Saaras STT voice transcription model selector
SARVAM_STT_MODEL=saaras:v1
